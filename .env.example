# Hocco PM Tool — keys this project needs.
# Copy this file to ".env" and fill in the real values there.
# ".env" is listed in .gitignore, so it never goes to GitHub.
# Find the values in Supabase → Project Settings → API Keys.

# Project address. Not secret.
SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key (starts "sb_publishable_", older projects call it "anon").
# SAFE for the website: it only allows what the Row Level Security rules allow.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (starts "sb_secret_", older projects call it "service_role").
# SECRET: it bypasses every security rule. Never put it in any website file,
# never commit it, never paste it into chat. Only needed later for scheduled
# jobs (Phase 6), where it's stored inside Supabase, not here.
SUPABASE_SECRET_KEY=
